# SurrealDB (compose + service)
SURREAL_PORT=8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_LOG_LEVEL=info
# uid:gid the container runs as; must own ./data/surrealdb (output of `id -u`:`id -g`)
SURREAL_RUN_AS=1000:1000

# Service -> SurrealDB
SURREALMEM_SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREALMEM_SURREAL_NAMESPACE=surrealmem
SURREALMEM_SURREAL_DATABASE=memory
SURREALMEM_SURREAL_USER=root
SURREALMEM_SURREAL_PASS=root

# API
SURREALMEM_API_HOST=127.0.0.1
SURREALMEM_API_PORT=8790
SURREALMEM_API_TOKEN=change-me

# Inference (OpenAI-compatible endpoints served by llama-server)
SURREALMEM_LLM_BASE_URL=http://127.0.0.1:8081/v1
SURREALMEM_LLM_MODEL=qwen3-30b-a3b-instruct
SURREALMEM_LLM_API_KEY=
SURREALMEM_LLM_TEMPERATURE=0.1
SURREALMEM_LLM_MAX_TOKENS=2500
SURREALMEM_LLM_TIMEOUT_SECONDS=180
SURREALMEM_LLM_FALLBACK_BASE_URL=https://api.venice.ai/api/v1
SURREALMEM_LLM_FALLBACK_MODEL=
SURREALMEM_LLM_FALLBACK_API_KEY=
SURREALMEM_EMBED_BASE_URL=http://127.0.0.1:8082/v1
SURREALMEM_EMBED_MODEL=qwen3-embedding-0.6b
SURREALMEM_EMBED_DIMENSION=1024

# Extraction, resolution, worker
SURREALMEM_EXTRACTION_WINDOW=6
SURREALMEM_RESOLUTION_AUTO_MERGE=0.92
SURREALMEM_RESOLUTION_REVIEW=0.80
SURREALMEM_WORKER_POLL_SECONDS=1.0
SURREALMEM_WORKER_LEASE_SECONDS=300

# Logging / telemetry
SURREALMEM_LOG_LEVEL=INFO
SURREALMEM_LOG_JSON=true
SURREALMEM_OTEL_ENABLED=false

# Container stack (`just docker-up`): published ports and where containers find inference.
# host.docker.internal only works when the llama-server units bind 0.0.0.0 (ops/inference.local.env).
SURREALMEM_API_PUBLISHED_PORT=8790
DASHBOARD_PORT=4200
SURREALMEM_CONTAINER_LLM_BASE_URL=http://host.docker.internal:8081/v1
SURREALMEM_CONTAINER_EMBED_BASE_URL=http://host.docker.internal:8082/v1
