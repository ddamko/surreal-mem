[Unit]
Description=surrealmem instruct model (llama-server, ROCm) for extraction and reflection
Documentation=file://{{REPO}}/docs/adr/0009-local-first-llm-with-venice-fallback.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart={{LLAMA_SERVER}} \
    --model {{MODELS_DIR}}/{{LLM_FILE}} \
    --alias {{LLM_ALIAS}} \
    --host {{LLAMA_BIND_HOST}} --port {{LLM_PORT}} \
    --n-gpu-layers 999 --ctx-size {{LLM_CTX}} --parallel 2 \
    --flash-attn on --jinja --metrics --no-webui
ExecStartPost=/usr/bin/curl -fsS --retry 90 --retry-delay 2 --retry-connrefused --retry-all-errors http://127.0.0.1:{{LLM_PORT}}/health
TimeoutStartSec=300
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
KillMode=mixed
KillSignal=SIGTERM
Slice=background-graphical.slice

[Install]
WantedBy=graphical-session.target
