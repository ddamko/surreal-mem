# Inference defaults rendered into the systemd unit templates by scripts/inference.nu.
# Override any value in ops/inference.local.env (gitignored).
LLAMA_SRC=$HOME/.local/share/surrealmem/llama.cpp
LLAMA_ARCH=gfx1151
LLAMA_SERVER=$HOME/.local/share/surrealmem/llama.cpp/build-hip/bin/llama-server
MODELS_DIR=$HOME/.local/share/surrealmem/models
LLM_REPO=unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF
LLM_FILE=Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf
LLM_ALIAS=qwen3-30b-a3b-instruct
LLM_PORT=8081
# Bind address for both llama-server units. 127.0.0.1 keeps them private to this machine; set
# 0.0.0.0 (behind a firewall) when the container stack must reach them via host.docker.internal.
LLAMA_BIND_HOST=127.0.0.1
LLM_CTX=32768
EMBED_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBED_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_ALIAS=qwen3-embedding-0.6b
EMBED_PORT=8082
